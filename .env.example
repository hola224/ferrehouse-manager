# Copiar a .env. NUNCA commitear .env.

# connection_limit=1 NO es cosmético: serializa las escrituras.
# Sin él, dos ventas simultáneas del mismo producto corrompen el saldo
# del libro de stock en silencio (decisión sellada 16, ADR-006).
DATABASE_URL="file:./ferrehouse.db?connection_limit=1"

# Secreto de firma de los JWT. En instalación se genera al azar.
JWT_SECRET="cambiar-en-instalacion"

# PIN inicial, solo para el PRIMER seed: si el usuario ya existe, el seed no
# lo toca. Dejándolos vacíos se usan los del README —111111 y 222222—, que son
# públicos y sirven para probar el proyecto recién clonado.
#
# UNA INSTALACIÓN DE VERDAD LOS DEFINE ACÁ. Es la diferencia entre una tienda
# cuyo PIN de administrador está publicado en internet y una que no.
SEED_ADMIN_PIN=""
SEED_SELLER_PIN=""

PORT=3000
