<?xml version="1.0" encoding="utf-8"?>
<!--
  El manifiesto que hace que Windows pida los permisos ANTES de abrir el
  programa.

  `requireAdministrator` es lo que dibuja el escudo en el icono y muestra el
  aviso de UAC al hacer doble clic. Sin esto, el programa arrancaria sin
  permisos, se daria cuenta a mitad de camino y tendria que relanzarse — lo que
  abre y cierra una consola primero, y eso se ve igual que algo que fallo.

  `supportedOS` no es burocracia: sin declarar Windows 10, el sistema le miente
  al programa sobre su propia version y sobre el DPI de la pantalla, para no
  romper programas viejos que asumen otra cosa.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="Ferrehouse.Instalador" type="win32" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
</assembly>
